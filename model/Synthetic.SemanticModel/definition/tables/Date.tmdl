/// Neutral, contiguous January 2026 calendar. No customer or entitlement attributes.
table Date
	dataCategory: Time

	/// Integer calendar foreign-key target in YYYYMMDD format.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: 0
		summarizeBy: none
		sourceColumn: Date Key

	/// Unique midnight calendar date, typed as DateTime in the semantic model.
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	/// Calendar year; not an additive quantity.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	/// Calendar month number; not an additive quantity.
	column Month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Month

	/// Calendar day of month; not an additive quantity.
	column Day
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Day

	partition Date = m
		mode: import
		source =
			#table(
			    type table [#"Date Key" = Int64.Type, Date = datetime, Year = Int64.Type, Month = Int64.Type, Day = Int64.Type],
			    {
			        {20260101, #datetime(2026, 1, 1, 0, 0, 0), 2026, 1, 1},
			        {20260102, #datetime(2026, 1, 2, 0, 0, 0), 2026, 1, 2},
			        {20260103, #datetime(2026, 1, 3, 0, 0, 0), 2026, 1, 3},
			        {20260104, #datetime(2026, 1, 4, 0, 0, 0), 2026, 1, 4},
